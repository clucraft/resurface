{
  "name": "resurface",
  "private": true,
  "version": "0.1.0",
  "description": "Resurface — scan-to-CAD reverse engineering: turn 3D scans into editable CAD surfaces and solids.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:stable": "vite --mode nohmr",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "replicad-opencascadejs": "1.1.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
